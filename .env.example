# Copy to .env (gitignored) and fill in. Generate secrets with: openssl rand -hex 24
POSTGRES_USER=prospector
POSTGRES_PASSWORD=change-me
PROSPECTOR_DB=prospector
# Encrypts credentials stored in n8n. Losing it makes saved credentials unreadable.
N8N_ENCRYPTION_KEY=change-me
# Google Places API (New) key, restricted to Places API (New) (+ IP restriction). Leave empty until created.
GOOGLE_PLACES_API_KEY=
# Crawl helper (src/prospector/crawl.py). Leave CRAWL_ENABLED=false until the crawl policy is approved and
# the contact page and mailbox are live and tested. Any value other than "true" disables all prospect-site fetches.
CRAWL_ENABLED=false
CRAWL_CONTACT_URL=
CRAWL_CONTACT_EMAIL=
