        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT COALESCE(SUM(requests_made),0)::int AS used_this_month, $1::int AS monthly_limit, $2::int AS needed,\n  (COALESCE(SUM(requests_made),0) + $2::int <= $1::int) AS allowed\nFROM discovery_runs\nWHERE params->>'source' = 'places' AND billable AND started_at >= date_trunc('month', now())",
          "options": {
            "queryReplacement": "={{ [$('Discovery Parameters').first().json.monthlyRequestLimit, Math.min($('Discovery Parameters').first().json.maxPages, 3)] }}"
          }
