      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH input AS (\n  SELECT * FROM jsonb_to_recordset($1::jsonb)\n    AS x(place_id text, name text, category text, address text, website_url text, phone text, source_query text)\n  WHERE COALESCE(place_id,'') <> '' AND COALESCE(name,'') <> ''\n),\nins AS (\n  INSERT INTO prospects (place_id, name, category, address, website_url, phone, source_query, source, source_record_id)\n  SELECT place_id, name, NULLIF(category,''), NULLIF(address,''), NULLIF(website_url,''), NULLIF(phone,''), source_query,\n    CASE WHEN $2::jsonb->>'source' = 'places' THEN 'google_places' ELSE 'mock' END, place_id\n  FROM input\n  ON CONFLICT (place_id) DO NOTHING\n  RETURNING place_id\n),\nstats AS (\n  SELECT (SELECT count(*) FROM input)::int AS valid, (SELECT count(*) FROM ins)::int AS inserted\n)\nINSERT INTO discovery_runs (n8n_execution_id, params, fetched, invalid, inserted, duplicates, status, requests_made)\nSELECT $4::text, $2::jsonb, $3::int, $3::int - valid, inserted, valid - inserted,\n  CASE WHEN $3::int = 0 THEN 'no_results' WHEN valid = 0 THEN 'no_valid_records' ELSE 'ok' END,\n  $5::int\nFROM stats\nRETURNING id AS run_id, status, fetched, invalid, inserted, duplicates, requests_made",
          "options": {
            "queryReplacement": "={{ [JSON.stringify($json.data ?? []), JSON.stringify($(\"Discovery Parameters\").first().json), $(\"Normalize Prospect Data\").all().filter(i => i.json.place_id || i.json.name || i.json.address).length, $execution.id, $(\"Places Search\").isExecuted ? $(\"Places Search\").all().length : 0] }}"
          }
        },
