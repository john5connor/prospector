      {
        "parameters": {
          "jsCode": "// MOCK of Google Places API (New) Text Search results. Replace with an HTTP Request node later.\n// mockScenario: normal | all_invalid | empty  (test knob; disappears with the mock)\nconst p = $('Discovery Parameters').first().json;\nconst places = [\n  { id: 'ChIJmock0001', displayName: { text: 'Motor City Heating & Cooling' }, formattedAddress: '123 Main St, Royal Oak, MI 48067, USA', nationalPhoneNumber: '(248) 555-0101', websiteUri: 'https://example.com/motorcity', primaryType: 'hvac_contractor' },\n  { id: 'ChIJmock0002', displayName: { text: 'Pontiac Climate Control' }, formattedAddress: '45 Saginaw St, Pontiac, MI 48342, USA', nationalPhoneNumber: '(248) 555-0102', websiteUri: 'https://example.com/pontiac', primaryType: 'hvac_contractor' },\n  { id: 'ChIJmock0003', displayName: { text: 'Troy Comfort Systems' }, formattedAddress: '900 Big Beaver Rd, Troy, MI 48084, USA', nationalPhoneNumber: '(248) 555-0103', primaryType: 'hvac_contractor' },\n  { id: 'ChIJmock0004', displayName: { text: 'Novi Furnace Pros' }, formattedAddress: '27000 Novi Rd, Novi, MI 48377, USA', websiteUri: 'https://example.com/novi', primaryType: 'hvac_contractor' },\n  { id: 'ChIJmock0005', displayName: { text: 'Farmington Air Experts' }, formattedAddress: '33000 Grand River Ave, Farmington, MI 48336, USA', nationalPhoneNumber: '(248) 555-0105', websiteUri: 'https://example.com/farmington', primaryType: 'hvac_contractor' },\n  { id: 'ChIJmock0001', displayName: { text: 'Motor City Heating & Cooling' }, formattedAddress: '123 Main St, Royal Oak, MI 48067, USA', nationalPhoneNumber: '(248) 555-0101', websiteUri: 'https://example.com/motorcity', primaryType: 'hvac_contractor' },\n  { displayName: { text: 'Record Missing Place ID' }, formattedAddress: '1 Nowhere Ln, Auburn Hills, MI, USA' },\n  { id: 'ChIJmock0008', displayName: { text: '' }, formattedAddress: '2 Blank Name Ct, Southfield, MI, USA' }\n];\nlet out = places;\nif (p.mockScenario === 'empty') out = [];\nif (p.mockScenario === 'all_invalid') out = places.slice(6);\nreturn out.slice(0, p.maxResults).map(pl => ({ json: pl }));"
        },
