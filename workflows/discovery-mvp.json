        "id": "d993e152-ec0b-4b1a-91a5-fe0e5111b5ac",
        "name": "Batch Valid Records",
        "type": "n8n-nodes-base.aggregate",
        "typeVersion": 1,
        "position": [
          1120,
          0
        ]
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH input AS (\n  SELECT * FROM jsonb_to_recordset($1::jsonb)\n    AS x(place_id text, name text, category text, address text, website_url text, phone text, source_query text)\n  WHERE COALESCE(place_id,'') <> '' AND COALESCE(name,'') <> ''\n),\nins AS (\n  INSERT INTO prospects (place_id, name, category, address, website_url, phone, source_query)\n  SELECT place_id, name, NULLIF(category,''), NULLIF(address,''), NULLIF(website_url,''), NULLIF(phone,''), source_query\n  FROM input\n  ON CONFLICT (place_id) DO NOTHING\n  RETURNING place_id\n),\nstats AS (\n  SELECT (SELECT count(*) FROM input)::int AS valid, (SELECT count(*) FROM ins)::int AS inserted\n)\nINSERT INTO discovery_runs (n8n_execution_id, params, fetched, invalid, inserted, duplicates, status)\nSELECT $4::text, $2::jsonb, $3::int, $3::int - valid, inserted, valid - inserted,\n  CASE WHEN $3::int = 0 THEN 'no_results' WHEN valid = 0 THEN 'no_valid_records' ELSE 'ok' END\nFROM stats\nRETURNING id AS run_id, status, fetched, invalid, inserted, duplicates",
          "options": {
            "queryReplacement": "={{ [JSON.stringify($json.data ?? []), JSON.stringify($(\"Discovery Parameters\").first().json), $(\"Mock Places Response\").all().filter(i => Object.keys(i.json).length > 0).length, $execution.id] }}"
          }
        },
